# Copy this file to .env.local (git-ignored) and fill in your Firebase
# project's web app config: Firebase console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → Config.
#
# These values are meant to be public (Firestore security rules are what
# actually protect data — see PLAN.md §5), but they're kept out of the repo
# so it doesn't hardcode one groomer's project and CI can build without them.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run against the local Firebase emulators (see
# `firebase emulators:start` in the repo root) instead of a real project.
# Useful for developing before real Firebase credentials exist.
VITE_USE_FIREBASE_EMULATORS=false

# Optional: the shared "Try the demo" account's login. When set, the login
# page shows a "Try the demo" button that signs a visitor straight into
# this account in read-only mode (see DemoModeContext). Leave both unset
# to hide that button — nothing else depends on these.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
